<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>$(SolutionName)</AssemblyName>
		<RootNamespace>$(SolutionName).$(MSBuildProjectName)</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- Builds for the platform's architecture (see pub/Directory.Build.props), so the installers get the right build. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(NuDepotArchitecture)</RuntimeIdentifier>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<!-- Kestrel serves the feed, behind a reverse proxy if one is used, so there's no IIS web.config. -->
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Feed\Feed.csproj" />
		<ProjectReference Include="..\..\src\Gallery\Gallery.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The installer puts NuDepot.json, the settings template, in C:\ProgramData\NuDepot; F5 reads it from the build output. The development settings aren't published. -->
		<Content Update="NuDepot.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
	</ItemGroup>
</Project>
