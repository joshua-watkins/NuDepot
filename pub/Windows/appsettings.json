{
  "Feed": {
    // An Admin API key. If no keys are set and users aren't enabled, anyone may do anything.
    "ApiKey": "",

    // Uncomment this to give API keys roles: ReadOnly, ReadWrite or Admin. The feed checks keys,
    // with their roles, once any are set. Clients send a key in the
    // X-NuGet-ApiKey header (push -k), or as the password of the source's credentials in nuget.config.
    // With Users enabled, people sign in to the gallery with passkeys and create their own API keys.
    // The first account is an Admin.
    //"Authorization": {
    //  "AnonymousRole": "ReadOnly",
    //  "ApiKeys": [
    //    { "Name": "Build server", "Key": "", "Role": "ReadWrite" }
    //  ],
    //  "Users": {
    //    "Enabled": true,
    //    "AllowSignUp": true,
    //    "DefaultRole": "ReadOnly"
    //  }
    //},

    "PackageDeletionBehavior": "Unlist",
    "AllowPackageOverwrites": false,

    // Where clients like Visual Studio link to a package's page in the gallery. Only advertised over HTTPS.
    "PackageDetailsUriTemplate": "packages/{id}/{version}",

    // Uncomment this to repository sign pushed packages with a code signing certificate.
    //"RepositorySigning": {
    //  "CertificatePath": "signing.pfx",
    //  "CertificatePassword": "",
    //  "TimestampServerUrl": "http://timestamp.digicert.com"
    //},
    // Not recommended: or generate a self-signed certificate each year. NuGet clients warn about such packages.
    //"RepositorySigning": { "GenerateCertificates": true },

    // A Windows Service's working directory is C:\Windows\System32, so use absolute paths.
    "Database": {
      "ConnectionString": "Data Source=C:\\ProgramData\\NuDepot\\nudepot.db"
    },

    // FileSystem or Null.
    "Storage": {
      "Type": "FileSystem",
      "Path": "C:\\ProgramData\\NuDepot"
    },

    // Database or Null.
    "Search": {
      "Type": "Database"
    },

    "Mirror": {
      // Enabling mirror will ensure that all packages used are copied to the local server
      "Enabled": true,
      // The NuGet V3 feed to mirror.
      "PackageSource": "https://api.nuget.org/v3/index.json"
    }
  },

  // The gallery reads packages through the NuGet V3 API. By default it uses the feed
  // hosted in this application. Uncomment this to show packages from another feed instead.
  //"Gallery": {
  //  "ServiceIndexUrl": "https://feed.example.com/v3/index.json"
  //},

  "Logging": {
    "Console": {
      "LogLevel": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Default": "Warning"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
