{
  // NuDepot's settings, in C:\ProgramData\NuDepot with its database and packages. Every setting is optional:
  // each has a default. This file overrides setup.ini, which holds what you chose when installing, and upgrades
  // don't change either. Relative paths, like a certificate's, are relative to this folder. Restart the NuDepot
  // service after changing settings. All the settings:
  // https://github.com/joshua-watkins/NuDepot/blob/main/docs/configuration.md

  // NuDepot listens on http://localhost:3333 (or the port you chose when installing), for a reverse proxy
  // that serves HTTPS. To listen somewhere else, or serve HTTPS itself, uncomment this:
  //"Kestrel": {
  //  "Endpoints": {
  //    "Http": { "Url": "http://localhost:3333" },
  //    //"Https": {
  //    //  "Url": "https://*:443",
  //    //  "Certificate": { "Path": "nuget.example.com.pfx", "Password": "" }
  //    //},
  //  }
  //},

  "Feed": {
    // Users, repository signing and mirroring are set up below, and each is off until it's turned on: when
    // installing (USERS=1, SIGNING=1 or MIRROR=1, which setup.ini records), or with "IsEnabled": true here, which
    // overrides setup.ini. "IsEnabled": false here turns off what the installer turned on.
    "Authorization": {
      // One key for each role. Clients send a key with push's -k option, or as the password of the feed's
      // credentials in nuget.config, with the role as the user name, like ReadWrite. Without keys, the feed is
      // open: anyone may read and push. A ReadWrite key keeps others from pushing, and a ReadOnly key makes the
      // feed private.
      //
      // The keys below are examples, which everyone who installs NuDepot has, and the service logs a warning while
      // one is in use. Don't just uncomment them: replace them with random keys of your own, like from this
      // PowerShell command:
      // $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
      "ApiKeys": {
        //"ReadOnly": "",
        //"ReadWrite": "63ffea38ce443e60fc53b9cfde476b6e4b4188c2667257e2",
        //"Admin": "41d521b060687fec5dc036a747b1423d27672ab0a0d96ebe",
      },

      // People sign in to the gallery with passkeys, and create their own API keys for NuGet clients. The first
      // account is an Admin.
      "Users": {
        //"IsEnabled": true,
        // Whether requests without a key or a signed-in user may read the feed. With users, they may only read.
        "AnonymousReads": true,
        // Whether anyone may create an account. The first account can always be created.
        "AllowSignUp": true,
        // The role of new accounts after the first.
        "DefaultRole": "ReadOnly",
      },
    },

    // Repository sign pushed packages. The feed then only answers HTTPS: through a reverse proxy, or Kestrel's
    // HTTPS endpoint. By default, it generates and manages a self-signed certificate for each year, which NuGet
    // clients warn about.
    "RepositorySigning": {
      //"IsEnabled": true,

      // Or sign with your own code signing certificate, which the service's account must be able to read.
      //"CertificatePath": "signing.pfx",
      //"CertificatePassword": "",
      //"TimestampServerUrl": "http://timestamp.digicert.com",
    },

    // Mirror nuget.org: packages that aren't on this feed are downloaded from it, and kept. The mirrors are asked
    // in this order, and the first one that has a package provides all its versions, so put private feeds first.
    // A mirror that can't be reached isn't asked for 5 minutes, and is skipped meanwhile. With "WhenUnreachable":
    // "Stop", requests stop at it instead, so nuget.org can't provide packages with the same IDs as yours. The mirrors
    // are asked at most 50 times a second, so busy clients can't get this server throttled by nuget.org: beyond that,
    // requests for packages the feed doesn't have get 429 Too Many Requests. 0 removes the limit.
    "Mirroring": {
      //"IsEnabled": true,
      //"MaxLookupsPerSecond": 50,
      "Mirrors": [
        //{ "Name": "Internal", "PackageSource": "https://nuget.example.com/v3/index.json", "WhenUnreachable": "Stop" },
        { "Name": "nuget.org", "PackageSource": "https://api.nuget.org/v3/index.json" },
      ],
    },

    // Delete packages permanently instead of unlisting them, and let Admins replace existing packages.
    //"PackageDeletionBehavior": "HardDelete",
    //"AllowPackageOverwrites": true,

    // The largest package or symbol package that may be pushed, in bytes: 250 MB, like nuget.org, unless set here.
    // 0 removes the limit. A reverse proxy has its own limit, like nginx's client_max_body_size, to raise too.
    //"MaxPackageSize": 262144000,

    // NuDepot trusts X-Forwarded-Proto and X-Forwarded-For from a reverse proxy on this machine or a private network.
    // List a proxy with a public address here. Turn forwarded headers off if clients can reach NuDepot without going
    // through the proxy from a private network, since they could set those headers too.
    //"TrustedProxies": [ "203.0.113.7" ],
    //"UseForwardedHeaders": false,

    // Each client may send 2000 requests at once, enough to restore a large solution, and 200 a second after that.
    // A signed-in user, or a user's API key, is one client wherever it sends from; anyone else is limited by their
    // address, which is the proxy's unless the proxy is trusted above. An address may also send 20 keys that aren't
    // valid in 15 minutes, and try to sign up or sign in 30 times in 10. Turn the limits off if the reverse proxy
    // limits requests instead. For a feed open to the internet, anonymous clients can be limited together too.
    //"RateLimiting": {
    //  "IsEnabled": false,
    //  "RequestBurst": 2000,
    //  "RequestsPerSecond": 200,
    //  "AnonymousRequestsPerSecond": 100,
    //},
  },

  // Show another feed's packages in the gallery, instead of this feed's.
  //"Gallery": { "ServiceIndexUrl": "https://feed.example.com/v3/index.json" },

  // The host names clients use, separated by semicolons. Requests for other hosts are refused, instead of being
  // answered with links to them. Keep localhost, or the address NuDepot listens on: the gallery reads the feed there.
  //"AllowedHosts": "nuget.example.com;localhost",

  // NuDepot logs warnings and errors to the Event Log (Application log, source NuDepot): refused requests, keys that
  // aren't valid, failed sign-ins and deleted packages. For verbose logging, which also keeps who pushed and unlisted
  // packages, who signed in and created API keys, and each step of a push, uncomment this:
  //"Logging": {
  //  "EventLog": {
  //    "LogLevel": {
  //      "Default": "Warning",
  //      "NuDepot": "Information",
  //      "NuDepot.Feed.Authentication": "Warning",
  //    },
  //  },
  //},
}
