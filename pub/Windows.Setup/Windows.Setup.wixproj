<Project Sdk="WixToolset.Sdk/7.0.1">

	<PropertyGroup>
		<!--
			One installer per architecture, chosen by the platform: x64 (the default) or ARM64, like
			"dotnet build -p:Platform=ARM64". Each installs a build of the service for its architecture.
		-->
		<InstallerPlatform>$(NuDepotArchitecture)</InstallerPlatform>
		<OutputName>NuDepot-$(InstallerPlatform)</OutputName>
		<!-- Some .NET runtime files are versioned without a language; that's expected for a self-contained app. -->
		<SuppressIces>ICE60</SuppressIces>
		<AcceptEula>wix7</AcceptEula>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Publish the Windows service as a self-contained app for the installer's architecture, so the
			target machine doesn't need the .NET runtime. The publish output is available to the .wxs
			files as !(bindpath.Windows). The service picks its runtime identifier from its platform:
			WiX drops a RuntimeIdentifier from AdditionalProperties, and a solution build replaces
			SetPlatform with the solution's platform for the project. The self-contained build has folders of its
			own: in the service's usual ones, it would mix its files with the framework-dependent build's, and the
			service wouldn't start ("Could not resolve CoreCLR path").
		-->
		<ProjectReference Include="..\Windows\Windows.csproj"
						  Publish="true"
						  SetPlatform="Platform=$(Platform)"
						  AdditionalProperties="SelfContained=true;OutputPath=bin\$(Platform)\$(Configuration)\self-contained\;IntermediateOutputPath=obj\$(Platform)\$(Configuration)\self-contained\" />
	</ItemGroup>

	<!--
		The installer takes every file in the service's publish folder, which publishing doesn't empty, so a file the
		service no longer has, like a renamed settings template, would still be installed. Publish into an empty one.
	-->
	<Target Name="CleanServicePublish" BeforeTargets="ResolveProjectReferences">
		<RemoveDir Directories="$(IntermediateOutputPath)publish\" />
	</Target>

	<!-- The installer isn't a NuGet package. This lets "dotnet pack NuDepot.slnx" pack the libraries. -->
	<Target Name="Pack" />

</Project>
