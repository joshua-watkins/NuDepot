{
  // NuDepot's settings, in /etc/nudepot. The database and packages are in /var/lib/nudepot. Every setting is
  // optional: each has a default. This file overrides setup.ini, which holds what you chose when installing, and
  // upgrades don't change either. Relative paths, like a certificate's, are relative to this folder. Restart the
  // service after changing settings: sudo systemctl restart nudepot. All the settings:
  // https://github.com/joshua-watkins/NuDepot/blob/main/docs/configuration.md

  // NuDepot listens on http://localhost:3333 (or the port you chose when installing), for a reverse proxy
  // that serves HTTPS. To listen somewhere else, or serve HTTPS itself, uncomment this:
  //"Kestrel": {
  //  "Endpoints": {
  //    "Http": { "Url": "http://localhost:3333" },
  //    //"Https": {
  //    //  // Ports below 1024, like 443, need CAP_NET_BIND_SERVICE: see nudepot.service.
  //    //  "Url": "https://*:3334",
  //    //  "Certificate": { "Path": "nuget.example.com.pfx", "Password": "" }
  //    //},
  //  }
  //},

  "Feed": {
    // Without API keys or users, anyone may read, push and unlist packages, and nobody may do what only an Admin may.
    //"Authorization": {
    //  // One key for each role. Clients send a key with push's -k option, or as the password of the feed's
    //  // credentials in nuget.config, with the role as the user name, like ReadWrite. A ReadWrite key stops
    //  // anonymous pushes, and a ReadOnly key makes the feed private. Leave out the keys you don't need.
    //  "ApiKeys": {
    //    "ReadOnly": "",
    //    "ReadWrite": "",
    //    "Admin": "",
    //  },
    //
    //  // People sign in to the gallery with passkeys, and create API keys for NuGet clients. The first account is
    //  // an Admin. With users, anonymous requests may only read, or nothing with "AnonymousReads": false.
    //  //"Users": { "Enabled": true, "AnonymousReads": true },
    //},

    // Repository sign pushed packages, with a self-signed certificate the feed generates each year. NuGet clients
    // warn about packages signed with it. The feed then only answers HTTPS: through a reverse proxy, or Kestrel's
    // HTTPS endpoint.
    //"RepositorySigning": { "Enabled": true },

    // Or sign with your own code signing certificate, which the nudepot user must be able to read.
    //"RepositorySigning": {
    //  "Enabled": true,
    //  "CertificatePath": "signing.pfx",
    //  "CertificatePassword": "",
    //  "TimestampServerUrl": "http://timestamp.digicert.com",
    //},

    // Mirror nuget.org: packages that aren't on this feed are downloaded from it, and kept.
    //"Mirror": { "Enabled": true },

    // Delete packages permanently instead of unlisting them, and let Admins replace existing packages.
    //"PackageDeletionBehavior": "HardDelete",
    //"AllowPackageOverwrites": true,

    // NuDepot trusts X-Forwarded-Proto and X-Forwarded-For from a reverse proxy. Turn that off if clients can
    // reach NuDepot without going through the proxy, since they could set those headers too.
    //"UseForwardedHeaders": false,
  },

  // Show another feed's packages in the gallery, instead of this feed's.
  //"Gallery": { "ServiceIndexUrl": "https://feed.example.com/v3/index.json" },
}
