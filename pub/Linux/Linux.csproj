<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>$(SolutionName)</AssemblyName>
		<RootNamespace>$(SolutionName).$(MSBuildProjectName)</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- Builds for the platform's architecture (see pub/Directory.Build.props). -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-$(NuDepotArchitecture)</RuntimeIdentifier>
		<RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
		<!-- Kestrel serves the feed, behind a reverse proxy if one is used, so there's no IIS web.config. -->
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
		<!-- Publishing also makes the release archive, like bin/Release/NuDepot-linux-x64.tar.gz. -->
		<NuDepotArchive>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), 'bin', $(Configuration), 'NuDepot-$(RuntimeIdentifier).tar.gz'))</NuDepotArchive>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Feed\Feed.csproj" />
		<ProjectReference Include="..\..\src\Gallery\Gallery.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- install.sh puts nudepot.json, the settings template, in /etc/nudepot; F5 reads it from the build output. The development settings aren't published. -->
		<Content Update="nudepot.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
		<None Update="nudepot.service;install.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- The archive holds the published files, install.sh and nudepot.service, with no top folder. -->
	<Target Name="NuDepotArchive" AfterTargets="Publish">
		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(NuDepotArchive)'))" />
		<Delete Files="$(NuDepotArchive)" />
		<Exec Command="tar -czf &quot;$(NuDepotArchive)&quot; -C &quot;$(PublishDir.TrimEnd('\/'))&quot; ." />
		<Message Importance="high" Text="$(MSBuildProjectName) -> $(NuDepotArchive)" />
	</Target>
</Project>
