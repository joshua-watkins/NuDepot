<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>$(SolutionName)</AssemblyName>
		<RootNamespace>$(SolutionName).$(MSBuildProjectName)</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- Builds for the platform's architecture (see pub/Directory.Build.props). -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-$(NuDepotArchitecture)</RuntimeIdentifier>
		<RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Feed\Feed.csproj" />
		<ProjectReference Include="..\..\src\Gallery\Gallery.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="nudepot.service">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
