[Unit]
Description=NuDepot A lightweight NuGet and symbol server.
After=network.target
StartLimitIntervalSec=10

[Service]
# The application reports start-up and shutdown to systemd (UseSystemd/AddSystemd).
Type=notify
ExecStart=/usr/share/nudepot/NuDepot

# The settings are in /etc/nudepot, which is NuDepot's working directory. The database and packages are in
# /var/lib/nudepot, which systemd creates, owned by the service's user.
ConfigurationDirectory=nudepot
StateDirectory=nudepot

# The data holds the API keys the service makes, data protection's keys, and private packages, so other users of the
# machine may not read it, or the files NuDepot creates.
StateDirectoryMode=0750
UMask=0027

# Uncomment this to let NuDepot listen on ports below 1024, like 443.
#AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=1
User=nudepot
Group=nudepot
SyslogIdentifier=nudepot

# NuDepot only writes to /var/lib/nudepot.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
