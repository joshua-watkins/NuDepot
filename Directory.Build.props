<Project>

	<!--
		Assembly names come from the solution's name, like NuDepot.Feed. A project evaluated on its own, like a test
		program that dotnet test runs or a project that dotnet ef reads, has no solution, so it gets the solution's
		name from here.
	-->
	<PropertyGroup>
		<SolutionName Condition="'$(SolutionName)' == '' Or '$(SolutionName)' == '*Undefined*'">NuDepot</SolutionName>
	</PropertyGroup>

	<!--
		One version for the services, their installer and archive, and the NuGet packages. Releases are built by
		build/release.ps1, which sets it to the build's date and time, like 26.11.14.26100. Everyday builds, like
		Visual Studio's, keep this placeholder, so they build incrementally and are never mistaken for a release.
	-->
	<PropertyGroup>
		<VersionPrefix>0.0.0</VersionPrefix>
	</PropertyGroup>

</Project>
