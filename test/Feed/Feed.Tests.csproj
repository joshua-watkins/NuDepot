<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- xUnit v3 test projects are programs, which dotnet test runs with Microsoft.Testing.Platform (see global.json). -->
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>$(SolutionName).$(MSBuildProjectName)</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Feed\Feed.csproj" />
		<!-- The gallery hosted with the feed, whose management the tests check. -->
		<ProjectReference Include="..\..\src\Gallery\Gallery.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The hosts' settings, which the tests check. -->
		<None Include="..\..\pub\Windows\NuDepot.json;..\..\pub\Windows\appsettings.Development.json" Link="Hosts\Windows\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\pub\Linux\nudepot.json;..\..\pub\Linux\appsettings.Development.json" Link="Hosts\Linux\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="TestData\ServiceIndex.json" />
		<EmbeddedResource Include="TestData\TestData.1.2.3.nupkg">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="TestData\TestData.1.2.3.snupkg">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Protocol" Version="7.9.0" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
		<PackageReference Include="Moq" Version="4.21.0" />
		<PackageReference Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

</Project>
