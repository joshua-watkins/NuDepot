<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>$(SolutionName).$(MSBuildProjectName)</RootNamespace>
		<Description>A nuget.org-style website for browsing a NuGet V3 feed, for ASP.NET Core applications. Add it with services.AddNuDepotGallery() and app.UseNuDepotGallery(), next to NuDepot.Feed or pointed at any V3 feed.</Description>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<!-- Generates the minimal API endpoints' request handling at compile time instead of with reflection. -->
		<EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
		<!-- Razor Slices compiles the pages with the Razor compiler's MVC support. The website doesn't use MVC at runtime. -->
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<!-- The website's files are embedded in the assembly (see WebsiteFiles) rather than static web assets. -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Humanizer" Version="3.0.10" />
		<PackageReference Include="Markdig" Version="1.5.1" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="RazorSlices" Version="0.12.2" />
	</ItemGroup>

	<PropertyGroup>
		<EnableDefaultRazorSlices>false</EnableDefaultRazorSlices>
	</PropertyGroup>
	<ItemGroup>
		<!-- Only treat .cshtml files in Slices directory as Razor Slices. The layout is a slice too. -->
		<RazorSlice Include="Slices\**\*.cshtml" Exclude="Slices\**\_ViewImports.cshtml" />
	</ItemGroup>

	<!--
		Razor Slices generates a public class for each slice, which can't take the gallery's internal models, so
		its generator is off, and Slices has an internal class for each slice instead, like Slices\Upload.cs.
	-->
	<Target Name="NuDepotInternalSliceProxies" AfterTargets="ResolveRazorSlicesInputs">
		<ItemGroup>
			<RazorGenerate>
				<GenerateRazorSlice>false</GenerateRazorSlice>
			</RazorGenerate>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<Content Remove="wwwroot\**" />
		<EmbeddedResource Include="wwwroot\**" />
		<!-- How the libraries in wwwroot\lib are restored. Not for applications that use the package. -->
		<Content Update="libman.json" Pack="false" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The tests create the slices' models directly. -->
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
	</ItemGroup>

</Project>
