@inherits RazorSlice<IndexModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div class="search-options">
    <div class="search-option">
        <span id="package-type-label">Package type:</span>

        <details class="dropdown">
            <summary class="btn btn-outline-secondary" aria-labelledby="package-type-label package-type">
                <span id="package-type">@IndexModel.PackageTypes.GetValueOrDefault(Model.PackageType, "Other")</span>
                <i class="icon icon-chevron-down" aria-hidden="true"></i>
            </summary>
            <ul class="dropdown-menu">
                @foreach (var packageType in IndexModel.PackageTypes)
                {
                    <li><a class="dropdown-item" href="@Model.SearchLink(packageType: packageType.Key, page: 1)">@packageType.Value</a></li>
                }
            </ul>
        </details>
    </div>

    <div class="search-option">
        <span id="framework-label">Framework:</span>

        <details class="dropdown">
            <summary class="btn btn-outline-secondary" aria-labelledby="framework-label framework">
                <span id="framework">@IndexModel.TargetFrameworks.GetValueOrDefault(Model.Framework, "Other")</span>
                <i class="icon icon-chevron-down" aria-hidden="true"></i>
            </summary>
            <ul class="dropdown-menu">
                @foreach (var framework in IndexModel.TargetFrameworks)
                {
                    if (framework.Key.StartsWith("divider"))
                    {
                        <li><hr class="dropdown-divider" /></li>
                    }
                    else if (framework.Key.StartsWith("header"))
                    {
                        <li><h6 class="dropdown-header">@framework.Value</h6></li>
                    }
                    else
                    {
                        <li><a class="dropdown-item" href="@Model.SearchLink(framework: framework.Key, page: 1)">@framework.Value</a></li>
                    }
                }
            </ul>
        </details>
    </div>

    <div class="search-option form-check">
        <input type="checkbox"
               class="form-check-input"
               id="prerelease"
               checked="@Model.Prerelease"
               data-navigate="@Model.SearchLink(prerelease: !Model.Prerelease, page: 1)" />
        <label class="form-check-label" for="prerelease">Include prerelease</label>
    </div>
</div>

@if (Model.Packages.Count == 0)
{
    <div>
        <h2>Oops, nothing here...</h2>
        <p>
            It looks like there's no package here to see. Take a look below for useful links.
        </p>
        <p><a href="@Model.PathBase/upload">Upload a package</a></p>
    </div>
}
else
{
    @foreach (var package in Model.Packages)
    {
        <div class="row search-result">
            <div class="col-md-1 d-none d-md-block">
                <img src="@(package.IconUrl ?? LayoutModel.Content(DefaultIcon))"
                     class="package-icon img-fluid"
                     data-fallback="@LayoutModel.Content(DefaultIcon)"
                     alt="" />
            </div>
            <div class="col-md-11">
                <div>
                    <a href="@Model.PathBase/packages/@Uri.EscapeDataString(package.PackageId)/@Uri.EscapeDataString(package.Version)"
                       class="package-title">
                        @package.PackageId
                    </a>
                    <span>by: @string.Join(" ", package.Authors ?? Array.Empty<string>())</span>
                </div>
                <ul class="info">
                    <li>
                        <i class="icon icon-download" aria-hidden="true"></i>
                        @package.TotalDownloads.ToMetric() total downloads
                    </li>
                    <li>
                        <i class="icon icon-flag" aria-hidden="true"></i>
                        Latest version: @package.Version
                    </li>
                    @if (package.Tags?.Any() == true)
                    {
                        <li class="tags">
                            <i class="icon icon-tag" aria-hidden="true"></i>
                            @string.Join(" ", package.Tags)
                        </li>
                    }
                </ul>
                <div>
                    @package.Description
                </div>
            </div>
        </div>
    }

    var showPreviousLink = Model.PageIndex > 1;
    var showNextLink = Model.Packages.Count >= IndexModel.ResultsPerPage;

    if (showPreviousLink || showNextLink)
    {
        <nav class="pager" aria-label="Search page navigation">
            @if (showPreviousLink)
            {
                <a class="btn btn-outline-secondary" href="@Model.SearchLink(page: Model.PageIndex - 1)">Previous</a>
            }

            @if (showNextLink)
            {
                <a class="btn btn-outline-secondary" href="@Model.SearchLink(page: Model.PageIndex + 1)">Next</a>
            }
        </nav>
    }
}

@functions {
    private const string DefaultIcon = "images/default-package-icon-256x256.png";

    public LayoutModel LayoutModel => new("Packages", Model.PathBase, WebsitePage.Packages, Model.Query);

    protected override Task ExecuteSectionAsync(string name)
    {
        // The search query is in a form in the header. Pass the search filters back up to the header's search form.
        if (name == "SearchForm")
        {
            if (Model.PackageType != "any")
            {
                <input type="hidden" name="packageType" value="@Model.PackageType" />
            }

            if (Model.Framework != "any")
            {
                <input type="hidden" name="framework" value="@Model.Framework" />
            }

            if (!Model.Prerelease)
            {
                <input type="hidden" name="prerelease" value="False" />
            }
        }

        return Task.CompletedTask;
    }
}
