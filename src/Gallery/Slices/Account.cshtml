@inherits RazorSlice<AccountModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div class="account-page" id="account-page">
    <h1>
        <span id="account-name">@HttpContext!.User.Identity!.Name</span>
        <small id="account-role"></small>
    </h1>
    <hr class="breadcrumb-divider" />

    <div class="alert alert-danger" role="alert" data-account-error hidden></div>

    <section>
        <h2>Passkeys</h2>
        <p>You sign in with any of these passkeys. Add another so you can still sign in if you lose a device.</p>
        <table class="table account-table">
            <thead>
                <tr><th>Name</th><th>Added</th><th>Last used</th><th></th></tr>
            </thead>
            <tbody id="passkeys"></tbody>
        </table>
        <form id="add-passkey-form" class="inline-form">
            <div>
                <label for="passkey-name" class="visually-hidden">Passkey name</label>
                <input type="text" id="passkey-name" class="form-control" placeholder="Name, like &quot;Phone&quot;" maxlength="128" />
            </div>
            <button type="submit" class="btn btn-outline-secondary">Add a passkey</button>
        </form>
    </section>

    <section>
        <h2>API keys</h2>
        <p>
            NuGet clients and Visual Studio can't use passkeys, so they use an API key, as the password of the feed's
            credentials, with your user name. Each key can do what your account can.
        </p>
        <table class="table account-table">
            <thead>
                <tr><th>Name</th><th>Key</th><th>Created</th><th>Last used</th><th></th></tr>
            </thead>
            <tbody id="apikeys"></tbody>
        </table>
        <form id="create-apikey-form" class="inline-form">
            <div>
                <label for="apikey-name" class="visually-hidden">API key name</label>
                <input type="text" id="apikey-name" class="form-control" placeholder="Name, like &quot;Build server&quot;" maxlength="128" required />
            </div>
            <button type="submit" class="btn btn-outline-secondary">Create an API key</button>
        </form>

        <div id="new-apikey" class="new-apikey" hidden>
            <p><strong>Copy your new API key now.</strong> It won't be shown again.</p>
            <div class="command-box">
                <div class="script"><div id="new-apikey-value"></div></div>
                <button type="button" class="btn btn-copy" id="copy-apikey" title="Copy">
                    <i class="icon icon-clipboard" aria-hidden="true"></i>
                    <span class="visually-hidden">Copy</span>
                </button>
            </div>
            <p>
                Add it to your <code>nuget.config</code> as the feed's password, with your user name. NuGet sends it
                when it restores and pushes packages, so push without <code>-k</code>:
            </p>
            <pre id="new-apikey-config"></pre>
        </div>
    </section>

    <section>
        <h2>Signed-in browsers</h2>
        <p>You stay signed in for a year after you last use a browser. Sign out of any you don't recognize or don't use any more.</p>
        <table class="table account-table">
            <thead>
                <tr><th>Browser</th><th>Signed in</th><th>Last used</th><th></th></tr>
            </thead>
            <tbody id="sessions"></tbody>
        </table>
    </section>

    <section>
        <button type="button" class="btn btn-outline-secondary" id="signout-button">Sign out</button>
    </section>
</div>

@WebsiteJsonContext.ToSettingsScript("account-settings", new AccountScriptSettings(Model.PathBase, Model.PathBase + "/", Model.ServiceIndexUrl))
<script src="@LayoutModel.Content("js/account.js")" defer></script>

@functions {
    public LayoutModel LayoutModel => new("Your account", Model.PathBase, WebsitePage.Account);
}
