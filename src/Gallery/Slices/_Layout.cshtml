@inherits RazorLayoutSlice<LayoutModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NuDepot">
    <!-- Lets the browser draw the page in the system's light or dark colors before the styles load. -->
    <meta name="color-scheme" content="light dark">

    <link rel="icon" href="@Model.Content("favicon.ico")">

    <link rel="stylesheet" href="@Model.Content("lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Model.Content("css/site.css")" />
    <script src="@Model.Content("js/theme.js")"></script>

    <title>@Model.Title - NuDepot</title>
</head>
<body>
    <header class="site-header">
        <nav class="container site-nav" aria-label="Main">
            <ul class="site-nav-links">
                <li><a href="@Model.PathBase/" aria-current="@(Model.ActivePage == WebsitePage.Packages ? "page" : null)" class="@(Model.ActivePage == WebsitePage.Packages ? "active" : null)"><span>Packages</span></a></li>
                <li><a href="@Model.PathBase/upload" aria-current="@(Model.ActivePage == WebsitePage.Upload ? "page" : null)" class="@(Model.ActivePage == WebsitePage.Upload ? "active" : null)"><span>Upload</span></a></li>
            </ul>
            @if (HttpContext?.RequestServices.GetService(typeof(FeedConnection)) is FeedConnection { SignInAvailable: true })
            {
                <ul class="site-nav-links account-nav">
                    @if (WebsiteEndpoints.IsSignedIn(HttpContext))
                    {
                        @if (HttpContext.RequestServices.GetService(typeof(Visitor)) is Visitor { CanAdminister: true })
                        {
                            <li><a href="@Model.PathBase/admin" class="@(Model.ActivePage == WebsitePage.Admin ? "active" : null)"><i class="icon icon-gear" aria-hidden="true"></i> <span>Admin</span></a></li>
                        }
                        <li><a href="@Model.PathBase/account" class="@(Model.ActivePage == WebsitePage.Account ? "active" : null)"><i class="icon icon-person-circle" aria-hidden="true"></i> <span>@HttpContext.User.Identity!.Name</span></a></li>
                    }
                    else if (Model.ActivePage != WebsitePage.Account)
                    {
                        <li><a href="@WebsiteEndpoints.GetSignInUrl(HttpContext.Request)"><span>Sign in</span></a></li>
                    }
                </ul>
            }
        </nav>
        <div class="container search-container">
            <form action="@Model.PathBase/" method="get" role="search">
                <div class="input-group">
                    <input type="search"
                           name="q"
                           value="@Model.SearchQuery"
                           class="form-control"
                           autocomplete="off"
                           aria-label="Search packages"
                           placeholder="Search packages..." />
                    <button type="submit" class="btn btn-search" title="Search for packages">
                        <i class="icon icon-search" aria-hidden="true"></i>
                        <span class="visually-hidden">Search</span>
                    </button>
                </div>

                @await RenderSectionAsync("SearchForm")
            </form>
        </div>
    </header>

    <main class="container main-container">
        @await RenderBodyAsync()
    </main>

    <script src="@Model.Content("js/site.js")"></script>
</body>
</html>
