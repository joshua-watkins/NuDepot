@inherits RazorSlice<UploadModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div class="col-sm-12">
    <h1>Upload</h1>
    <hr class="breadcrumb-divider" />

    @if (Model.Visitor?.IsReadOnlyMode == true)
    {
        <div class="alert alert-info" role="alert">The feed is read-only: nobody may push packages to it for now.</div>
    }
    else if (Model.Visitor?.CanPush == true)
    {
        <section class="upload-packages" id="upload-packages">
            <h2>Upload from this browser</h2>
            <p>Choose packages (<code>.nupkg</code>) or symbol packages (<code>.snupkg</code>). A symbol package needs its package on the feed.</p>
            <form id="upload-form" class="form-inline">
                <div class="form-group">
                    <label for="upload-files" class="sr-only">Packages</label>
                    <input type="file" id="upload-files" class="form-control" accept=".nupkg,.snupkg" multiple required />
                </div>
                <button type="submit" class="btn btn-default btn-brand">Upload</button>
            </form>
            <ul class="list-unstyled upload-results" id="upload-results"></ul>
        </section>

        <h2>Push from the command line</h2>
    }

    <div>You can push packages using the service index <code>@Model.ServiceIndexUrl</code>.</div>

    <div class="tabbed-info" x-data="{ tabs: tabs, active: tabs[0] }">
        <ul class="nav">
            <template x-for="tab in tabs" :key="tab.name">
                <li x-bind:class="{ 'active': active.name === tab.name }">
                    <a href="#" x-text="tab.name" @@click="active = tab"></a>
                </li>
            </template>
        </ul>

        <div class="content">
            <div class="script">
                <template x-for="line in active.content">
                    <div class="script-line" x-text="line"></div>
                </template>
            </div>

            <div class="copy-button">
                <button class="btn btn-default btn-warning"
                        type="button"
                        @@click="window.nudepot.copyTextToClipboard(active.content.join('\n'), $el)">
                    <i class="ms-Icon ms-Icon--Copy"></i>
                </button>
            </div>
        </div>

        <div class="icon-text alert alert-warning">
            For more information, please refer to
            <a target="_blank"
               rel="noopener noreferrer"
               x-bind:href="active.documentation"
               x-text="`${active.name}'s documentation`">
            </a>.
        </div>
    </div>

    @if (Model.SigningCertificates.Count > 0)
    {
        <h2>Signatures</h2>
        <p>
            The feed signs its packages. To have NuGet trust its signatures, add its certificates to your
            <code>nuget.config</code>'s
            <a target="_blank" rel="noopener noreferrer" href="https://learn.microsoft.com/nuget/reference/nuget-config-file#trustedsigners-section">trusted signers</a>.
            The certificates change over time, and this page always shows the current ones.
        </p>

        <table class="table signing-certificates">
            <thead>
                <tr><th>SHA-256 fingerprint</th><th>Certificate</th><th>Valid</th></tr>
            </thead>
            <tbody>
                @foreach (SigningCertificateModel certificate in Model.SigningCertificates)
                {
                    <tr>
                        <td><code>@certificate.Fingerprint</code></td>
                        <td>@certificate.Subject</td>
                        <td>@certificate.NotBefore.ToString("yyyy-MM-dd") to @certificate.NotAfter.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        <pre class="trusted-signers">@Model.GetTrustedSignersConfig()</pre>
    }
</div>

<script type="text/javascript">
    let tabs = @WebsiteJsonContext.ToScriptValue(Model.GetPushInstructions());
</script>

@if (Model.Visitor?.CanPush == true)
{
    <script type="text/javascript">
        window.nudepotManage = @WebsiteJsonContext.ToScriptValue(new ManageScriptSettings(Model.PathBase));
    </script>
    <script src="@LayoutModel.Content("js/manage.js")" defer></script>
}

@functions {
    public LayoutModel LayoutModel => new("Upload package", Model.PathBase, WebsitePage.Upload);
}
