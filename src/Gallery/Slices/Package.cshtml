@inherits RazorSlice<PackageModel>
@implements IUsesLayout<_Layout, LayoutModel>

@if (!Model.Found)
{
    <div>
        <h2>Oops, package not found...</h2>
        <p>Could not find package '@Model.Package.PackageId'.</p>
        <p>You can try searching on <a href="https://www.nuget.org/packages?q=@Uri.EscapeDataString(Model.Package.PackageId)" target="_blank" rel="noopener noreferrer">nuget.org</a> package.</p>
    </div>
}
else
{
    <div class="row display-package">
        <aside class="col-md-1 package-icon">
            <img src="@(Model.IconUrl ?? LayoutModel.Content(DefaultIcon))"
                 class="img-fluid"
                 data-fallback="@LayoutModel.Content(DefaultIcon)"
                 alt="" />
        </aside>

        <article class="col-md-8 package-details-main">
            <div class="package-title">
                <h1>
                    @Model.Package.PackageId

                    <small class="text-nowrap">@Model.Version.ToNormalizedString()</small>
                </h1>
            </div>

            @if (Model.Deprecation != null)
            {
                <div class="alert alert-warning package-deprecation" role="alert">
                    <i class="icon icon-exclamation-triangle" aria-hidden="true"></i>
                    This package @string.Join(" and ", Model.Deprecation.Reasons.Select(PackageModel.DeprecationReasonText)).
                    @if (!string.IsNullOrEmpty(Model.Deprecation.Message))
                    {
                        <div>@Model.Deprecation.Message</div>
                    }
                    @if (Model.Deprecation.AlternatePackage != null)
                    {
                        <div>
                            Suggested alternative:
                            <a href="@Model.PackageLink(Model.Deprecation.AlternatePackage.Id)">@Model.Deprecation.AlternatePackage.Id</a>
                        </div>
                    }
                </div>
            }

            @foreach (var vulnerability in Model.Vulnerabilities)
            {
                <div class="alert alert-danger package-vulnerability" role="alert">
                    <i class="icon icon-shield-exclamation" aria-hidden="true"></i>
                    This package has a known @PackageModel.SeverityName(vulnerability.Severity) severity vulnerability,
                    <a href="@SafeUrls.AbsoluteOrNull(vulnerability.AdvisoryUrl)" target="_blank" rel="noopener noreferrer">@vulnerability.AdvisoryUrl</a>.
                </div>
            }

            @if (!Model.Package.IsListed())
            {
                <div class="alert alert-info package-unlisted" role="alert">
                    <i class="icon icon-eye-slash" aria-hidden="true"></i>
                    This version is unlisted: searches don't show it, but it can still be restored.
                </div>
            }

            @if (Model.IsManaged)
            {
                <div class="manage-package" id="manage-package">
                    @BeginSection("Manage", expanded: false)
                        <div class="alert alert-danger" role="alert" data-manage-error hidden></div>

                        @if (Model.Visitor!.CanUnlist || Model.Visitor.CanDelete)
                        {
                            <h3>Versions</h3>
                            <p class="text-muted">
                                @(Model.Visitor.DeletesPermanently
                                    ? "Deleting a version removes it from the feed permanently."
                                    : "An unlisted version is hidden from searches, but projects that use it can still restore it.")
                            </p>
                            <table class="table manage-versions">
                                <thead>
                                    <tr><th>Version</th><th>Status</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var version in Model.AllVersions)
                                    {
                                        var normalized = version.Version.ToNormalizedString();
                                        var packageUrl = $"{Model.PathBase}/api/v2/package/{Uri.EscapeDataString(Model.Package.PackageId)}/{Uri.EscapeDataString(normalized)}";

                                        <tr>
                                            <td><a href="@Model.PackageLink(Model.Package.PackageId, version.Version)">@normalized</a></td>
                                            <td>@(version.Listed ? "Listed" : "Unlisted")</td>
                                            <td class="text-end text-nowrap">
                                                @if (version.Listed && !Model.Visitor.DeletesPermanently && Model.Visitor.CanUnlist)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-manage-method="DELETE" data-manage-url="@packageUrl">Unlist</button>
                                                }
                                                @if (!version.Listed && Model.Visitor.CanUnlist)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-manage-method="POST" data-manage-url="@packageUrl">Relist</button>
                                                }
                                                @if (Model.Visitor.DeletesPermanently && Model.Visitor.CanDelete)
                                                {
                                                    <button type="button" class="btn btn-danger btn-sm" data-manage-method="DELETE" data-manage-url="@packageUrl"
                                                            data-manage-confirm="Delete @Model.Package.PackageId @normalized permanently? Projects that use it won't be able to restore it.">Delete</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (Model.Visitor.CanDeprecate)
                        {
                            <h3>Deprecation of @Model.Version.ToNormalizedString()</h3>
                            <form id="deprecation-form">
                                <div class="mb-3">
                                    @foreach (var reason in DeprecationReasons)
                                    {
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input" id="deprecation-@reason.Key" name="reasons" value="@reason.Key" checked="@(Model.Deprecation?.Reasons.Contains(reason.Key) == true)" />
                                            <label class="form-check-label" for="deprecation-@reason.Key">@reason.Value</label>
                                        </div>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="deprecation-message">Message</label>
                                    <input type="text" id="deprecation-message" name="message" class="form-control" maxlength="4000" value="@Model.Deprecation?.Message" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="deprecation-alternate">Alternative package ID</label>
                                    <input type="text" id="deprecation-alternate" name="alternatePackageId" class="form-control" maxlength="128" value="@Model.Deprecation?.AlternatePackage?.Id" />
                                </div>
                                <button type="submit" class="btn btn-outline-secondary">@(Model.Deprecation == null ? "Deprecate" : "Update the deprecation")</button>
                                @if (Model.Deprecation != null)
                                {
                                    <button type="button" class="btn btn-outline-secondary" data-manage-method="DELETE" data-manage-url="@DeprecationUrl">Remove the deprecation</button>
                                }
                            </form>
                        }

                        @if (Model.Visitor.CanManageVulnerabilities)
                        {
                            <h3>Known vulnerabilities of @Model.Package.PackageId</h3>
                            <table class="table manage-vulnerabilities">
                                <thead>
                                    <tr><th>Versions</th><th>Severity</th><th>Advisory</th><th></th></tr>
                                </thead>
                                <tbody id="vulnerabilities"></tbody>
                            </table>
                            <form id="vulnerability-form" class="inline-form">
                                <div>
                                    <label for="vulnerability-versions" class="visually-hidden">Vulnerable versions</label>
                                    <input type="text" id="vulnerability-versions" name="versions" class="form-control" placeholder="Versions, like (, 1.2.0)" required />
                                </div>
                                <div>
                                    <label for="vulnerability-url" class="visually-hidden">Advisory URL</label>
                                    <input type="url" id="vulnerability-url" name="url" class="form-control" placeholder="Advisory URL" required />
                                </div>
                                <div>
                                    <label for="vulnerability-severity" class="visually-hidden">Severity</label>
                                    <select id="vulnerability-severity" name="severity" class="form-select">
                                        <option value="0">Low</option>
                                        <option value="1">Moderate</option>
                                        <option value="2" selected>High</option>
                                        <option value="3">Critical</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-outline-secondary">Record the vulnerability</button>
                            </form>
                        }
                    @EndSection()
                </div>
            }

            <div class="tabbed-info" data-tabs>
                <div class="tab-list" role="tablist" aria-label="Install with">
                    @for (var i = 0; i < Instructions.Count; i++)
                    {
                        <button type="button" role="tab" id="install-tab-@i" aria-controls="install-panel-@i" aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? 0 : -1)">@Instructions[i].Name</button>
                    }
                </div>

                @for (var i = 0; i < Instructions.Count; i++)
                {
                    <div role="tabpanel" id="install-panel-@i" aria-labelledby="install-tab-@i" hidden="@(i != 0)">
                        <div class="command-box">
                            <div class="script">
                                @foreach (var line in Instructions[i].Content)
                                {
                                    <div class="script-line" data-prefix="@Instructions[i].Prefix">@line</div>
                                }
                            </div>
                            <button class="btn btn-copy" type="button" title="Copy" data-copy>
                                <i class="icon icon-clipboard" aria-hidden="true"></i>
                                <span class="visually-hidden">Copy</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            @BeginSection("Readme", expanded: false)
                <div>
                    @if (Model.Readme == null)
                    {
                        <div class="package-description">@Model.Package.Description</div>
                    }
                    else
                    {
                        <div class="package-readme">@Model.Readme</div>
                    }
                </div>
            @EndSection()

            @if (!Model.IsDotnetTemplate && !Model.IsDotnetTool)
            {
                @BeginSection("Used By", expanded: false)
                    <div class="package-used-by">
                        @if (!Model.UsedBy.Any())
                        {
                            <p>No packages depend on @Model.Package.PackageId.</p>
                        }
                        else
                        {
                            <p>Showing the top 20 packages that depend on @Model.Package.PackageId.</p>
                            <div>
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Packages</th>
                                            <th>Downloads</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var package in Model.UsedBy)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@Model.PackageLink(package.Id)">@package.Id</a>
                                                    <div>@package.Description</div>
                                                </td>
                                                <td class="text-nowrap">
                                                    <i class="icon icon-download" aria-hidden="true"></i>
                                                    <span>@package.TotalDownloads.ToString("N0")</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                @EndSection()
            }

            @if (!string.IsNullOrEmpty(Model.Package.ReleaseNotes))
            {
                @BeginSection("Release Notes", expanded: false)
                    <div class="package-release-notes">@Model.Package.ReleaseNotes</div>
                @EndSection()
            }

            @BeginSection("Dependencies", expanded: false)
                <div class="dependency-groups">
                    @if (Model.DependencyGroups == null || !Model.DependencyGroups.Any())
                    {
                        @:This package has no dependencies.
                    }
                    else
                    {
                        foreach (var group in Model.DependencyGroups)
                        {
                            <h4>
                                <span>@group.Name</span>
                            </h4>

                            <ul class="list-unstyled dependency-group">
                                @if (!group.Dependencies.Any())
                                {
                                    <li>No dependencies.</li>
                                }
                                else
                                {
                                    @foreach (var dependency in group.Dependencies)
                                    {
                                        <li>
                                            <a href="@Model.PackageLink(dependency.PackageId)">
                                                @dependency.PackageId
                                            </a>

                                            <span> @dependency.VersionSpec</span>
                                        </li>
                                    }
                                }
                            </ul>
                        }
                    }
                </div>
            @EndSection()

            @BeginSection("Versions", expanded: true)
                <div class="version-list" data-show-more-list>
                    <table class="table table-borderless">
                        <thead>
                            <tr>
                                <th>Version</th>
                                <th>Downloads</th>
                                <th>Last updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Versions.Count; i++)
                            {
                                var version = Versions[i];
                                var rowClass = string.Join(" ", new[] { version.Selected ? "selected-version" : null, i >= DefaultVisibleVersions ? "more" : null }.OfType<string>());

                                <tr class="@(rowClass.Length > 0 ? rowClass : null)" aria-current="@(version.Selected ? "page" : null)">
                                    <td><a href="@Model.PackageLink(Model.Package.PackageId, version.Version)">@version.Version.ToNormalizedString()</a></td>
                                    <td>@version.Downloads.ToString("N0")</td>
                                    <td>@version.LastUpdated.ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (Versions.Count > DefaultVisibleVersions)
                    {
                        <button type="button" class="link-button" aria-expanded="false" data-show-more>
                            <i class="icon icon-plus-circle" aria-hidden="true"></i>
                            <span>Show more</span>
                        </button>
                    }
                </div>
            @EndSection()
        </article>

        <aside class="col-md-3 package-details-info">
            <div>
                <h2>Info</h2>

                <ul class="list-unstyled icon-list">
                    <li>
                        <i class="icon icon-clock-history" aria-hidden="true"></i>
                        Last updated @Model.LastUpdated.Humanize()
                    </li>

                    @if (Model.ProjectUrl != null)
                    {
                        <li>
                            <i class="icon icon-globe" aria-hidden="true"></i>
                            <a href="@Model.ProjectUrl" rel="noopener noreferrer nofollow">Project URL</a>
                        </li>
                    }

                    @if (Model.RepositoryUrl != null)
                    {
                        <li>
                            <i class="icon icon-github" aria-hidden="true"></i>
                            <a href="@Model.RepositoryUrl" rel="noopener noreferrer nofollow">Source code</a>
                        </li>
                    }

                    @if (Model.LicenseUrl != null)
                    {
                        <li>
                            <i class="icon icon-file-earmark-text" aria-hidden="true"></i>
                            <a href="@Model.LicenseUrl">@(string.IsNullOrEmpty(Model.Package.LicenseExpression) ? "License" : $"License: {Model.Package.LicenseExpression}")</a>
                        </li>
                    }

                    <li>
                        <i class="icon icon-cloud-download" aria-hidden="true"></i>
                        <a href="@Model.PackageDownloadUrl">Download package</a>
                    </li>
                </ul>
            </div>

            <div>
                <h2>Statistics</h2>

                <ul class="list-unstyled icon-list">
                    <li>
                        <i class="icon icon-download" aria-hidden="true"></i>
                        @Model.TotalDownloads.ToString("N0") total downloads
                    </li>

                    <li>
                        <i class="icon icon-box-seam" aria-hidden="true"></i>
                        @Model.Package.Downloads.ToString("N0") downloads of current version
                    </li>
                </ul>
            </div>

            @if (!string.IsNullOrEmpty(Model.Package.Authors))
            {
                <div>
                    <h2>Authors</h2>

                    <p>@Model.Package.Authors</p>
                </div>
            }
        </aside>
    </div>

    @if (Model.IsManaged)
    {
        @WebsiteJsonContext.ToSettingsScript("manage-settings", new ManageScriptSettings(Model.PathBase, Model.Package.PackageId, Model.Version.ToNormalizedString()))
        <script src="@LayoutModel.Content("js/manage.js")" defer></script>
    }
}

@functions {
    private const string DefaultIcon = "images/default-package-icon-256x256.png";
    private const int DefaultVisibleVersions = 5;

    public LayoutModel LayoutModel => new(
        Model.Found ? $"{Model.Package.PackageId} {Model.Version.ToNormalizedString()}" : Model.Package.PackageId,
        Model.PathBase);

    private IReadOnlyList<PackageModel.VersionModel> Versions => Model.Versions ?? Array.Empty<PackageModel.VersionModel>();

    private IReadOnlyList<InstallInstructions>? _instructions;
    private IReadOnlyList<InstallInstructions> Instructions => _instructions ??= Model.GetInstallInstructions();

    // The reasons the feed's deprecation endpoint takes, and how the form shows them.
    private static readonly IReadOnlyDictionary<string, string> DeprecationReasons = new Dictionary<string, string>
    {
        ["Legacy"] = "No longer maintained",
        ["CriticalBugs"] = "Has critical bugs",
        ["Other"] = "Other",
    };

    private string DeprecationUrl
        => $"{Model.PathBase}/api/package/{Uri.EscapeDataString(Model.Package.PackageId)}/{Uri.EscapeDataString(Model.Version.ToNormalizedString())}/deprecation";

    // A section that the user can expand and collapse, which browsers do for <details> without scripts. Its content
    // goes between BeginSection and EndSection.
    private static HtmlString BeginSection(string title, bool expanded)
    {
        var encodedTitle = System.Text.Encodings.Web.HtmlEncoder.Default.Encode(title);

        return new HtmlString(
            $"<details class=\"expandable-section\"{(expanded ? " open" : "")}>" +
                "<summary>" +
                    "<h2>" +
                        "<i class=\"icon icon-chevron-right\" aria-hidden=\"true\"></i>" +
                        $"<span>{encodedTitle}</span>" +
                    "</h2>" +
                "</summary>" +
                "<div class=\"section-body\">");
    }

    private static HtmlString EndSection() => new("</div></details>");
}
