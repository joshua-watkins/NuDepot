@inherits RazorSlice<SignInModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div class="account-page" id="signin-page">
    <h1>Sign in</h1>
    <hr class="breadcrumb-divider" />

    <div class="alert alert-danger" role="alert" data-account-error hidden></div>

    <section>
        <p>Sign in with a passkey saved on this device, on your phone or in your password manager.</p>
        <form id="signin-form" class="inline-form">
            <div>
                <label for="signin-username" class="visually-hidden">User name</label>
                <input type="text"
                       id="signin-username"
                       class="form-control"
                       placeholder="User name"
                       autocomplete="username"
                       maxlength="64"
                       required />
            </div>
            <button type="submit" class="btn btn-brand" id="signin-button">
                <i class="icon icon-key" aria-hidden="true"></i> Sign in with a passkey
            </button>
        </form>
    </section>

    <section id="signup-section" hidden>
        <h2>Create an account</h2>
        <p>
            Your account is protected by a passkey instead of a password.
            <span id="signup-first" hidden>You're the first person to sign up, so your account will be an administrator.</span>
        </p>
        <form id="signup-form" class="inline-form">
            <div>
                <label for="signup-username" class="visually-hidden">User name</label>
                <input type="text"
                       id="signup-username"
                       class="form-control"
                       placeholder="User name"
                       autocomplete="username"
                       maxlength="64"
                       required />
            </div>
            <button type="submit" class="btn btn-outline-secondary">Create account</button>
        </form>
    </section>

    <p class="passkey-unsupported text-muted" hidden>Passkeys aren't available on this page. They need the gallery to be served over HTTPS.</p>
</div>

@WebsiteJsonContext.ToSettingsScript("account-settings", new AccountScriptSettings(Model.PathBase, Model.ReturnUrl))
<script src="@LayoutModel.Content("js/account.js")" defer></script>

@functions {
    public LayoutModel LayoutModel => new("Sign in", Model.PathBase, WebsitePage.Account);
}
