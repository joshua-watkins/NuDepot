@inherits RazorSlice<SignInModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div class="col-sm-12 account-page" id="signin-page">
    <h1>Sign in</h1>
    <hr class="breadcrumb-divider" />

    <div class="alert alert-danger" role="alert" data-account-error hidden></div>

    <section>
        <p>Sign in with a passkey saved on this device, on your phone or in your password manager.</p>
        <form id="signin-form" class="form-inline">
            <div class="form-group">
                <label for="signin-username" class="sr-only">User name</label>
                <input type="text"
                       id="signin-username"
                       class="form-control"
                       placeholder="User name"
                       autocomplete="username"
                       maxlength="64"
                       required />
            </div>
            <button type="submit" class="btn btn-default btn-brand" id="signin-button">
                <i class="ms-Icon ms-Icon--Permissions" aria-hidden="true"></i> Sign in with a passkey
            </button>
        </form>
    </section>

    <section id="signup-section" hidden>
        <h2>Create an account</h2>
        <p>
            Your account is protected by a passkey instead of a password.
            <span id="signup-first" hidden>You're the first person to sign up, so your account will be an administrator.</span>
        </p>
        <form id="signup-form" class="form-inline">
            <div class="form-group">
                <label for="signup-username" class="sr-only">User name</label>
                <input type="text"
                       id="signup-username"
                       class="form-control"
                       placeholder="User name"
                       autocomplete="username"
                       maxlength="64"
                       required />
            </div>
            <button type="submit" class="btn btn-default">Create account</button>
        </form>
    </section>

    <p class="passkey-unsupported text-muted" hidden>This browser doesn't support passkeys.</p>
</div>

<script type="text/javascript">
    window.nudepotAccount = @WebsiteJsonContext.ToScriptValue(new AccountScriptSettings(Model.PathBase, Model.ReturnUrl));
</script>
<script src="@LayoutModel.Content("js/account.js")" defer></script>

@functions {
    public LayoutModel LayoutModel => new("Sign in", Model.PathBase, WebsitePage.Account);
}
