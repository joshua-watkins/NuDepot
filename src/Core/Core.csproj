<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>$(SolutionName).$(MSBuildProjectName)</RootNamespace>
		<Description>The NuGet V3 protocol's models and a client for NuGet feeds. Shared by NuDepot.Feed and NuDepot.Gallery, with the builders they add themselves to.</Description>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<!-- For the builders the feed and the gallery add themselves to (see Hosting). -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Packaging" Version="7.9.0" />
		<!-- NuGet.Packaging references a vulnerable 8.0.1. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- The tests use the library's internal types. -->
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
	</ItemGroup>
</Project>
